{{ 'purelane.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane.js' | asset_url }}" defer></script>

<!-- Ambient Scene Backdrop & Sunlit Water Glow -->
<div class="scenes" id="scenes" data-d="1" aria-hidden="true">
  <div class="scene s1 on"></div>
  <div class="scene s2"></div>
  <div class="scene s3"></div>
  <div class="scene s4"></div>
  <div class="water" id="water">
    <div class="wl wl-a">
      <svg class="sv" viewBox="0 0 1800 1100" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="cg1" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#eafff4" stop-opacity="0"/>
            <stop offset=".18" stop-color="#f2fff8" stop-opacity=".95"/>
            <stop offset=".5" stop-color="#ffffff" stop-opacity="1"/>
            <stop offset=".82" stop-color="#e6fbef" stop-opacity=".9"/>
            <stop offset="1" stop-color="#eafff4" stop-opacity="0"/>
          </linearGradient>
        </defs>
        <path d="M262 230 Q372 261 482 238 Q592 247 702 250 Q812 210 923 235 Q1033 201 1143 213 Q1253 232 1363 215 Q1473 261 1583 238" stroke="url(#cg1)" stroke-width="2.5" fill="none" opacity="0.45" stroke-linecap="round"/>
        <path d="M137 256 Q307 242 477 258 Q646 238 816 245 Q985 259 1155 247 Q1324 277 1494 262 Q1664 267 1833 269" stroke="url(#cg1)" stroke-width="5" fill="none" opacity="0.25" stroke-linecap="round"/>
        <path d="M389 715 Q514 756 639 725 Q763 738 888 742 Q1013 688 1138 721 Q1262 674 1387 692 Q1512 716 1636 694" stroke="url(#cg1)" stroke-width="5.5" fill="none" opacity="0.35" stroke-linecap="round"/>
        <path d="M140 308 Q297 310 454 302 Q611 321 769 312 Q926 314 1083 316 Q1240 298 1397 309 Q1555 295 1712 300" stroke="url(#cg1)" stroke-width="5" fill="none" opacity="0.4" stroke-linecap="round"/>
      </svg>
    </div>
  </div>
</div>

<!-- Floating Navigation Header -->
<header id="hdr" class="pl-hdr">
  <div class="navpill pl-glass">
    <a class="brand" href="#hero" aria-label="Purelane homepage">
      <span class="mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3 20.5 8v8L12 21 3.5 16V8L12 3Z"/>
          <path d="M12 12 20.5 8M12 12v9M12 12 3.5 8"/>
        </svg>
      </span>
      <span class="txt">
        <span class="n1">{{ section.settings.brand_name | default: 'Purelane' }}</span>
        <span class="n2">{{ section.settings.tagline | default: 'Clean, simply' }}</span>
      </span>
    </a>

    <nav class="nav" id="mainNav" aria-label="Main Navigation">
      <a href="#hero" class="nav-link active">Home</a>
      <a href="#reviews" class="nav-link">Reviews</a>
      <a href="#combos" class="nav-link">Combos</a>
      <a href="#bundles" class="nav-link">Bundles</a>
      <a href="#shop" class="nav-link">Shop</a>
      <a href="#shop" class="nav-link">Ingredients</a>
      <span class="nav-indicator" id="navIndicator" aria-hidden="true"></span>
    </nav>

    <div class="navtools">
      <a class="ico hide-s" href="/search" aria-label="Search store" id="searchBtn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </a>
      <a class="ico hide-s" href="/account" aria-label="Customer account" id="accountBtn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="12" cy="8" r="3.6"/><path d="M5 20c0-3.6 3.1-5.6 7-5.6s7 2 7 5.6"/></svg>
      </a>
      <a class="ico" href="/cart" aria-label="View Cart" id="cartBtn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h2l2.2 10.4a1.6 1.6 0 0 0 1.6 1.3h7.6a1.6 1.6 0 0 0 1.6-1.3L20.5 9H6.4"/><circle cx="10" cy="20.5" r="1.1"/><circle cx="17.5" cy="20.5" r="1.1"/></svg>
        <span class="dot" id="cartCount" aria-live="polite">{{ cart.item_count | default: 0 }}</span>
      </a>
      <button class="ico burger" type="button" aria-label="Open mobile navigation menu" id="burgerBtn" aria-expanded="false" aria-controls="mobileDrawer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 8h16M4 16h16"/></svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div class="mob-drawer" id="mobileDrawer" role="dialog" aria-modal="true" aria-label="Navigation Menu">
  <div class="mob-overlay" id="mobOverlay"></div>
  <div class="mob-panel">
    <div class="mob-header">
      <span class="brand">
        <span class="mark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3 20.5 8v8L12 21 3.5 16V8L12 3Z"/></svg></span>
        <span class="n1" style="font-family:'Outfit', sans-serif;font-weight:800;font-size:16px;">Purelane</span>
      </span>
      <button class="ico" type="button" id="closeDrawerBtn" aria-label="Close navigation menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <nav class="mob-links">
      <a href="#hero" class="mob-nav-link">Home</a>
      <a href="#reviews" class="mob-nav-link">Reviews</a>
      <a href="#combos" class="mob-nav-link">Best-Selling Combos</a>
      <a href="#bundles" class="mob-nav-link">Build a Bundle</a>
      <a href="#shop" class="mob-nav-link">Shop All Products</a>
      <a href="#shop" class="mob-nav-link">Ingredients</a>
    </nav>
    <div style="margin-top:auto;padding-top:20px;border-top:1px solid rgba(75,58,143,0.1);">
      <a class="pl-btn pl-btn-primary" href="#bundles" style="width:100%; justify-content:center;">Build your bundle</a>
    </div>
  </div>
</div>

<!-- Desktop Side Progress Rail -->
<nav class="rail" aria-label="Page section progress">
  <a href="#hero" class="on" aria-label="Jump to Hero section"></a>
  <a href="#reviews" aria-label="Jump to Reviews section"></a>
  <a href="#combos" aria-label="Jump to Combos section"></a>
  <a href="#bundles" aria-label="Jump to Bundles section"></a>
  <a href="#shop" aria-label="Jump to Shop section"></a>
</nav>

{% schema %}
{
  "name": "Purelane Header",
  "tag": "section",
  "class": "section-purelane-header",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "Purelane"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Clean, simply"
    }
  ],
  "presets": [
    {
      "name": "Purelane Header"
    }
  ]
}
{% endschema %}
