      "default": "₹349"
    },
    {
      "type": "text",
      "id": "stage_2_compare",
      "label": "Stage 2 Compare Price",
      "default": "₹598"
    },
    {
      "type": "text",
      "id": "stage_2_discount",
      "label": "Stage 2 Discount Text",
      "default": "Save ₹249"
    },
    {
      "type": "header",
      "content": "Stage 3 (3 Products)"
    },
    {
      "type": "product",
      "id": "product_3_a",
      "label": "Product 3 - Bottle A"
    },
    {
      "type": "product",
      "id": "product_3_b",
      "label": "Product 3 - Bottle B"
    },
    {
      "type": "product",
      "id": "product_3_c",
      "label": "Product 3 - Bottle C"
    },
    {
      "type": "text",
      "id": "stage_3_label",
      "label": "Stage 3 Label",
      "default": "Any 3 products"
    },
    {
      "type": "text",
      "id": "stage_3_price",
      "label": "Stage 3 Price",
      "default": "₹499"
